# Canonical origin of the app (Stripe return URLs, Origin checks). Production: the https URL.
APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run types`
SUPABASE_PROJECT_REF=
# Only for db:setup / verify scripts (never needed at runtime)
DATABASE_URL=postgresql://postgres@127.0.0.1:54322/postgres

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bearer secret for /api/cron/expire-qrs
CRON_SECRET=

# School registration notification email via Resend (the email is skipped if either
# RESEND_API_KEY or SCHOOL_REGISTRATION_TO_EMAIL is empty)
RESEND_API_KEY=
EMAIL_FROM=Kokua Counter <noreply@example.com>
SCHOOL_REGISTRATION_TO_EMAIL=

# Shown on the privacy, terms and donate pages (neutral wording is used when empty)
CONTACT_EMAIL=
OPERATING_ORGANIZATION=

# Optional: where operational alerts (stuck refunds or payouts, ledger mismatches) are emailed
ALERT_EMAIL=

# Daily limits (optional; defaults shown)
MEALS_PER_DAY=1
PASSES_GENERATED_PER_DAY=3
EATERY_DAILY_LIMIT=200

# Local development only. Never enable in production.
ENABLE_DEV_LOGIN=false
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_EATERY_PASSWORD=
