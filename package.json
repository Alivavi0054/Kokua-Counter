{
  "name": "kokua-counter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF",
    "db:setup": "tsx --env-file=.env.local scripts/setup-db.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed-users.ts",
    "dev:credit": "tsx --env-file=.env.local scripts/dev-credit.ts",
    "verify": "tsx --env-file=.env.local scripts/verify.ts",
    "check:client-secrets": "tsx scripts/check-client-secrets.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts",
    "setup:connect": "node scripts/enable-stripe-connect.mjs",
    "test:permissions": "node scripts/e2e/run-permissions.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.6.0",
    "eslint-config-next": "16.4.0",
    "pg": "^8.12.0",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
