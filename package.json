{
  "name": "kokua-counter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF",
    "db:setup": "tsx --env-file=.env.local scripts/setup-db.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed-users.ts",
    "dev:credit": "tsx --env-file=.env.local scripts/dev-credit.ts",
    "verify": "tsx --env-file=.env.local scripts/verify.ts",
    "check:client-secrets": "tsx scripts/check-client-secrets.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.52.0",
    "next": "15.5.27",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "vitest": "3.2.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.27",
    "pg": "^8.12.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
